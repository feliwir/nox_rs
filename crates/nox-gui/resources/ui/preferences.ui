<?xml version="1.0" encoding="UTF-8"?>
<interface domain="nox">
  <!-- Preferences (preferences.rs): the timeline's thumbnails and
       waveforms, how video is decoded, the AI models and the packages.
       Changes apply at once. Subtitles are plain text: they show paths. -->
  <template class="NoxPreferencesDialog" parent="AdwPreferencesDialog">
    <property name="title" translatable="yes">Preferences</property>
    <property name="search-enabled">false</property>
    <child>
      <object class="AdwPreferencesPage">
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Timeline</property>
            <child>
              <object class="AdwSwitchRow" id="thumbnails">
                <property name="title" translatable="yes">_Thumbnails on Video Clips</property>
                <property name="use-underline">true</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="waveforms">
                <property name="title" translatable="yes">_Waveforms on Audio Clips</property>
                <property name="use-underline">true</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Playback</property>
            <child>
              <object class="AdwComboRow" id="decoding">
                <property name="title" translatable="yes">Video _decoding</property>
                <property name="use-underline">true</property>
                <property name="use-markup">false</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">AI Models</property>
            <child>
              <object class="AdwActionRow" id="models_row">
                <property name="title" translatable="yes">Downloaded Models</property>
                <property name="use-markup">false</property>
                <child type="suffix">
                  <object class="GtkButton" id="delete_models">
                    <property name="label" translatable="yes">_Delete</property>
                    <property name="use-underline">true</property>
                    <property name="valign">center</property>
                    <property name="tooltip-text" translatable="yes">Delete Downloaded Models</property>
                    <signal name="clicked" handler="on_delete_models_clicked" swapped="true"/>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Packages</property>
            <child>
              <object class="AdwActionRow" id="effects_row">
                <property name="title" translatable="yes">Effects</property>
                <property name="use-markup">false</property>
                <property name="subtitle-selectable">true</property>
                <child type="suffix">
                  <object class="GtkButton">
                    <property name="label" translatable="yes">_Open Folder</property>
                    <property name="use-underline">true</property>
                    <property name="valign">center</property>
                    <property name="tooltip-text" translatable="yes">Open the Effects Folder</property>
                    <signal name="clicked" handler="on_open_effects_clicked" swapped="true"/>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwActionRow" id="transitions_row">
                <property name="title" translatable="yes">Transitions</property>
                <property name="use-markup">false</property>
                <property name="subtitle-selectable">true</property>
                <child type="suffix">
                  <object class="GtkButton">
                    <property name="label" translatable="yes">_Open Folder</property>
                    <property name="use-underline">true</property>
                    <property name="valign">center</property>
                    <property name="tooltip-text" translatable="yes">Open the Transitions Folder</property>
                    <signal name="clicked" handler="on_open_transitions_clicked" swapped="true"/>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
