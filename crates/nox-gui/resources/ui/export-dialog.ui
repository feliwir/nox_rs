<?xml version="1.0" encoding="UTF-8"?>
<interface domain="nox">
  <!-- Export: preset, file, container, video codec and quality, audio codec, dynamic range (SDR or
       HDR), the encoder (with what it's good at), the range (whole timeline or In to Out), then progress while
       the timeline renders. -->
  <template class="NoxExportDialog" parent="AdwDialog">
    <property name="title" translatable="yes">Export</property>
    <property name="default-widget">start</property>
    <property name="content-width">640</property>
    <property name="content-height">700</property>
    <property name="child">
      <!-- A header bar with the title and close button over the content. -->
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar"/>
        </child>
        <property name="content">
          <object class="AdwPreferencesPage">
            <child>
              <object class="AdwPreferencesGroup" id="settings">
                <property name="title" translatable="yes">Render Settings</property>
                <child>
                  <object class="AdwComboRow" id="preset">
                    <property name="title" translatable="yes">_Preset</property>
                    <property name="use-underline">true</property>
                  </object>
                </child>
                <child>
                  <object class="AdwEntryRow" id="path">
                    <property name="title" translatable="yes">_File</property>
                    <property name="use-underline">true</property>
                    <property name="activates-default">true</property>
                    <child type="suffix">
                      <object class="GtkButton">
                        <property name="label" translatable="yes">_Browse…</property>
                        <property name="use-underline">true</property>
                        <property name="valign">center</property>
                        <signal name="clicked" handler="on_browse_clicked" swapped="true"/>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwComboRow" id="container">
                    <property name="title" translatable="yes">Con_tainer</property>
                    <property name="use-underline">true</property>
                  </object>
                </child>
                <child>
                  <object class="AdwComboRow" id="codec">
                    <property name="title" translatable="yes">_Video codec</property>
                    <property name="use-underline">true</property>
                  </object>
                </child>
                <child>
                  <object class="AdwComboRow" id="quality">
                    <property name="title" translatable="yes">_Quality</property>
                    <property name="use-underline">true</property>
                  </object>
                </child>
                <child>
                  <object class="AdwComboRow" id="dynamic_range">
                    <property name="title" translatable="yes">D_ynamic range</property>
                    <property name="use-underline">true</property>
                    <property name="tooltip-text" translatable="yes">HDR exports are 10-bit Rec. 2020 (HEVC or ProRes); SDR material sits at 203 nits, as BT.2408 recommends</property>
                  </object>
                </child>
                <!-- HDR10 only (export_dialog.rs). -->
                <child>
                  <object class="AdwSpinRow" id="peak">
                    <property name="title" translatable="yes">Mastering _peak</property>
                    <property name="subtitle" translatable="yes">nits</property>
                    <property name="use-underline">true</property>
                    <property name="tooltip-text" translatable="yes">Brightest the HDR10 master is meant for; written into the file for players and TVs</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">400</property>
                        <property name="upper">10000</property>
                        <property name="value">1000</property>
                        <property name="step-increment">100</property>
                        <property name="page-increment">1000</property>
                      </object>
                    </property>
                  </object>
                </child>
                <!-- Its subtitle tells what the choice does (export_dialog.rs). -->
                <child>
                  <object class="AdwComboRow" id="encoder">
                    <property name="title" translatable="yes">Enco_der</property>
                    <property name="use-underline">true</property>
                    <property name="use-markup">false</property>
                  </object>
                </child>
                <child>
                  <object class="AdwComboRow" id="audio_codec">
                    <property name="title" translatable="yes">A_udio codec</property>
                    <property name="use-underline">true</property>
                  </object>
                </child>
                <child>
                  <object class="AdwSwitchRow" id="audio">
                    <property name="title" translatable="yes">Include _audio</property>
                    <property name="use-underline">true</property>
                    <property name="active">true</property>
                  </object>
                </child>
                <child>
                  <object class="AdwComboRow" id="range">
                    <property name="title" translatable="yes">Ra_nge</property>
                    <property name="use-underline">true</property>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow" id="summary">
                    <property name="title" translatable="yes">Timeline</property>
                    <property name="use-markup">false</property>
                    <property name="subtitle-selectable">true</property>
                  </object>
                </child>
              </object>
            </child>
            <!-- While exporting, and its outcome. -->
            <child>
              <object class="AdwPreferencesGroup">
                <child>
                  <object class="GtkProgressBar" id="progress">
                    <property name="show-text">true</property>
                    <property name="visible">false</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="status">
                    <property name="wrap">true</property>
                    <property name="visible">false</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
        <child type="bottom">
          <object class="GtkBox">
            <property name="spacing">8</property>
            <property name="halign">end</property>
            <property name="margin-top">8</property>
            <property name="margin-bottom">12</property>
            <property name="margin-start">12</property>
            <property name="margin-end">12</property>
            <child>
              <object class="GtkButton" id="open_folder">
                <property name="label" translatable="yes">Open F_older</property>
                <property name="use-underline">true</property>
                <property name="visible">false</property>
                <signal name="clicked" handler="on_open_folder_clicked" swapped="true"/>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="cancel">
                <property name="label" translatable="yes">_Cancel</property>
                <property name="use-underline">true</property>
                <signal name="clicked" handler="on_cancel_clicked" swapped="true"/>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="start">
                <property name="label" translatable="yes">_Export</property>
                <property name="use-underline">true</property>
                <signal name="clicked" handler="on_export_clicked" swapped="true"/>
                <style><class name="suggested-action"/></style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
